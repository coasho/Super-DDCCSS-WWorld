// fsim: the ocean's wave spectrum, each cascade's (world::Clouds, its sea). From GodotOceanWaves
// (github.com/2Retr0/GodotOceanWaves, MIT, Copyright (c) 2024 Ethan Truong; see LICENSE-GodotOceanWaves.txt):
// assets/shaders/compute/spectrum_compute.glsl - the TMA spectrum (JONSWAP with Kitaigorodskii's depth attenuation),
// Hasselmann directional spreading with swell, a Gaussian random amplitude per wave vector, stored with its -k
// conjugate. Changes marked fsim: every cascade in one dispatch (the workgroup's z), its parameters from the clouds'
// uniform block; each cascade keeps only the waves between its band's edges, so the cascades add up to the spectrum
// once (overlapping, as GodotOceanWaves lets them, every wave length they share was counted again in each).
//
// Sources: Jerry Tessendorf - Simulating Ocean Water; Christopher J. Horvath - Empirical Directional Wave Spectra
// for Computer Graphics.

#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "clouds/types.glsl"
#include "fsim/params.glsl"
#include "ocean/ocean.glsl"

layout(set = 0, binding = 24, rgba16f) uniform writeonly image2DArray spectrum;

// --- HELPER FUNCTIONS ---
// Source: https://www.shadertoy.com/view/Xt3cDn
vec2 hash(in uvec2 x) {
  uint h32 = x.y + 374761393U + x.x * 3266489917U;
  h32 = 2246822519U * (h32 ^ (h32 >> 15));
  h32 = 3266489917U * (h32 ^ (h32 >> 13));
  uint n = h32 ^ (h32 >> 16);
  uvec2 rz = uvec2(n, n * 48271U);
  return vec2((rz.xy >> 1) & uvec2(0x7FFFFFFFU)) / float(0x7FFFFFFF);
}

/** Samples a 2D-bivariate normal distribution */
vec2 gaussian(in vec2 x) {
  // Use Box-Muller transform to convert uniform distribution->normal distribution.
  float r = sqrt(-2.0 * log(max(x.x, 1e-12)));
  float theta = 2.0 * PI * x.y;
  return vec2(r * cos(theta), r * sin(theta));
}

vec2 conj_complex(in vec2 x) { return vec2(x.x, -x.y); }

// --- SPECTRUM-RELATED FUNCTIONS ---
vec2 dispersion_relation(in float k, in float depth) {
  float a = k * depth;
  float b = tanh(a);
  float dispersion_relation = sqrt(G * k * b);
  float d_dispersion_relation = 0.5 * G * (b + a * (1.0 - b * b)) / dispersion_relation;
  return vec2(dispersion_relation, d_dispersion_relation);
}

float longuet_higgins_normalization(in float s) {
  float a = sqrt(s);
  return (s < 0.4) ? (0.5 / PI) + s * (0.220636 + s * (-0.109 + s * 0.090)) : inversesqrt(PI) * (a * 0.5 + (1.0 / a) * 0.0625);
}

float longuet_higgins_function(in float s, in float theta) {
  return longuet_higgins_normalization(s) * pow(abs(cos(theta * 0.5)), 2.0 * s);
}

float hasselmann_directional_spread(in float w, in float w_p, in float wind_speed, in float theta, in float swell, in float angle) {
  float p = w / w_p;
  float s = (w <= w_p) ? 6.97 * pow(abs(p), 4.06) : 9.77 * pow(abs(p), -2.33 - 1.45 * (wind_speed * w_p / G - 1.17));
  float s_xi = 16.0 * tanh(w_p / w) * swell * swell;
  return longuet_higgins_function(s + s_xi, theta - angle);
}

float TMA_spectrum(in float w, in float w_p, in float alpha, in float depth) {
  const float beta = 1.25;
  const float gamma = 3.3;
  float sigma = (w <= w_p) ? 0.07 : 0.09;
  float r = exp(-(w - w_p) * (w - w_p) / (2.0 * sigma * sigma * w_p * w_p));
  float jonswap_spectrum = (alpha * G * G) / pow(w, 5.0) * exp(-beta * pow(w_p / w, 4.0)) * pow(gamma, r);
  float w_h = min(w * sqrt(depth / G), 2.0);
  float kitaigorodskii_depth_attenuation = (w_h <= 1.0) ? 0.5 * w_h * w_h : 1.0 - 0.5 * (2.0 - w_h) * (2.0 - w_h);
  return jonswap_spectrum * kitaigorodskii_depth_attenuation;
}

vec2 get_spectrum_amplitude(in ivec2 id, in ivec2 map_size, in int cascade) {
  vec4 c = P_cascade[cascade];
  float tile_length = c.x;
  vec2 dk = vec2(2.0 * PI / tile_length);
  vec2 k_vec = (vec2(id) - vec2(map_size) * 0.5) * dk;
  float k = length(k_vec) + 1e-6;
  // fsim: only this cascade's band
  if (k < c.z || k >= c.w) return vec2(0.0);
  float theta = atan(k_vec.x, k_vec.y);

  float depth = OCEAN_SPECTRUM_DEPTH;
  vec2 dispersion = dispersion_relation(k, depth);
  float w = dispersion[0];
  float w_norm = dispersion[1] / k * dk.x * dk.y;
  float s = TMA_spectrum(w, OCEAN_PEAK_FREQUENCY, OCEAN_ALPHA, depth);
  float d = mix(0.5 / PI, hasselmann_directional_spread(w, OCEAN_PEAK_FREQUENCY, OCEAN_WIND_SPEED, theta, OCEAN_SWELL, OCEAN_WIND_ANGLE),
                1.0 - OCEAN_SPREAD) * exp(-(1.0 - OCEAN_DETAIL) * (1.0 - OCEAN_DETAIL) * k * k);
  // fsim: the amplitude that gives the field the spectrum's variance: a real field from k and -k together carries
  // |h0(k)|^2 + |h0(-k)|^2 at each wave vector, so E|h0|^2 is half the spectrum's share there, and the Gaussian's two
  // unit components give it twice that again (GodotOceanWaves' sqrt(2 s d w) made the waves 2.83 times too high -
  // 8 m significant height for a 7 m/s wind - and their slopes as much too steep)
  return gaussian(hash(uvec2(id + ivec2(cascade * 7919, cascade * 104729)))) * 0.5 * sqrt(s * d * w_norm);
}

void main() {
  const ivec2 dims = imageSize(spectrum).xy;
  const int cascade = int(gl_WorkGroupID.z);
  const ivec2 id0 = ivec2(gl_GlobalInvocationID.xy);
  const ivec2 id1 = ivec2(mod(vec2(-id0), vec2(dims)));
  imageStore(spectrum, ivec3(id0, cascade), vec4(get_spectrum_amplitude(id0, dims, cascade), conj_complex(get_spectrum_amplitude(id1, dims, cascade))));
}
