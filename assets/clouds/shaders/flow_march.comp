// fsim: half-resolution single-pass front-to-back volumetric raymarch for NVIDIA Flow (world::FlowVolumes, VIS-M12).
// Marches front-to-back across active Flow pages with early ray termination (B-60), exact scene-depth clamping,
// and single-fetch precomputed sun/sky transmittance (flowLight), writing premultiplied AgX RGBA16F + front hit distance
// for full-resolution depth-aware bilateral upsampling (flow_composite.frag).

#version 450
#define FLOW_COMPUTE
#include "flow.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 4) uniform sampler3D flowLight;
layout(set = 0, binding = 11) uniform MarchParams {
  mat4 inverseProjection;
  mat4 viewToEcef;
  vec4 screen; // fullW, fullH, halfW, halfH
  vec4 region; // rx0, ry0, rx1, ry1 (in half-res texels)
  vec4 counts; // pageCount, scale, 0, 0
};
layout(set = 0, binding = 12) uniform sampler2D sceneDepth;
layout(set = 0, binding = 13, rgba16f) uniform writeonly image2D halfColorOut;
layout(set = 0, binding = 14, rg32f) uniform writeonly image2D halfFrontOut;

const int STEPS = 160;

vec3 agx(vec3 color) {
  const mat3 LINEAR_SRGB_TO_LINEAR_REC2020 = mat3(vec3(0.6274, 0.0691, 0.0164), vec3(0.3293, 0.9195, 0.0880), vec3(0.0433, 0.0113, 0.8956));
  const mat3 LINEAR_REC2020_TO_LINEAR_SRGB = mat3(vec3(1.6605, -0.1246, -0.0182), vec3(-0.5876, 1.1329, -0.1006), vec3(-0.0728, -0.0083, 1.1187));
  const mat3 AgXInsetMatrix = mat3(vec3(0.856627153315983, 0.137318972929847, 0.11189821299995),
                                   vec3(0.0951212405381588, 0.761241990602591, 0.0767994186031903),
                                   vec3(0.0482516061458583, 0.101439036467562, 0.811302368396859));
  const mat3 AgXOutsetMatrix = mat3(vec3(1.1271005818144368, -0.1413297634984383, -0.14132976349843826),
                                    vec3(-0.11060664309660323, 1.157823702216272, -0.11060664309660294),
                                    vec3(-0.016493938717834573, -0.016493938717834257, 1.2519364065950405));
  const float AgxMinEv = -12.47393, AgxMaxEv = 4.026069;
  color = LINEAR_SRGB_TO_LINEAR_REC2020 * color;
  color = AgXInsetMatrix * color;
  color = max(color, 1e-10);
  color = log2(color);
  color = (color - AgxMinEv) / (AgxMaxEv - AgxMinEv);
  color = clamp(color, 0.0, 1.0);
  vec3 x2 = color * color, x4 = x2 * x2;
  color = 15.5 * x4 * x2 - 40.14 * x4 * color + 31.96 * x4 - 6.868 * x2 * color + 0.4298 * x2 + 0.1191 * color - 0.00232;
  color = AgXOutsetMatrix * color;
  color = pow(max(vec3(0.0), color), vec3(2.2));
  color = LINEAR_REC2020_TO_LINEAR_SRGB * color;
  return clamp(color, 0.0, 1.0);
}

vec2 henyeyGreenstein(const vec2 g, const float cosTheta) {
  vec2 g2 = g * g;
  return RECIPROCAL_PI4 * ((1.0 - g2) / max(vec2(1e-7), pow(1.0 + g2 - 2.0 * g * cosTheta, vec2(1.5))));
}
float phaseFunction(const float cosTheta) { return dot(henyeyGreenstein(vec2(0.7, -0.2), cosTheta), vec2(0.5)); }

vec2 slab(vec3 o, vec3 d, vec3 lo, vec3 size) {
  vec3 inv = 1.0 / d;
  vec3 a = (lo - o) * inv, b = (lo + size - o) * inv;
  vec3 near = min(a, b), far = max(a, b);
  return vec2(max(max(near.x, near.y), max(near.z, 0.0)), min(min(far.x, far.y), far.z));
}

float distanceAt(vec2 pixel, float z) {
  vec4 h = inverseProjection * vec4(pixel / screen.xy * 2.0 - 1.0, z, 1.0);
  return length(h.xyz / h.w);
}

vec2 flowLightAt(vec3 u) {
  int b = flowLastBrick;
  if (b < 0) return vec2(1.0);
  ivec3 L = flowLastLeaf;
  ivec3 base = ivec3(b % FLOW_BRICKS, (b / FLOW_BRICKS) % FLOW_BRICKS, b / (FLOW_BRICKS * FLOW_BRICKS)) * FLOW_LIGHT_BRICK;
  vec3 frac = clamp(u - vec3(L * 8), vec3(0.0), vec3(8.0));
  vec3 texel = vec3(base) + frac * 0.5 + 0.5;
  return texture(flowLight, texel / float(FLOW_BRICKS * FLOW_LIGHT_BRICK)).rg;
}

void main() {
  ivec2 c = ivec2(gl_GlobalInvocationID.xy) + ivec2(region.xy);
  if (c.x >= int(region.z) || c.y >= int(region.w)) return;

  int pageCount = int(counts.x);
  if (pageCount <= 0) {
    imageStore(halfColorOut, c, vec4(0.0));
    imageStore(halfFrontOut, c, vec4(0.0));
    return;
  }

  float scale = max(counts.y, 1.0);
  vec2 fullPx = (vec2(c) + 0.5) * scale;
  vec2 ndc = fullPx / screen.xy * 2.0 - 1.0;
  vec4 hv = inverseProjection * vec4(ndc, 1.0, 1.0);
  vec3 rayView = normalize(hv.xyz / hv.w);
  vec3 rayEcef = normalize(mat3(viewToEcef) * rayView);

  mat3 axes = mat3(samples[1].xyz, samples[2].xyz, samples[3].xyz);
  mat3 toLocal = transpose(axes);
  vec3 o = -(toLocal * samples[0].xyz);
  vec3 d = normalize(toLocal * rayEcef);

  // Conservative farthest depth across the covered full-res pixels (reverse Z: smaller z = farther).
  ivec2 maxDepthPx = max(min(textureSize(sceneDepth, 0), ivec2(screen.xy)) - 1, ivec2(0));
  ivec2 basePx = ivec2(floor(vec2(c) * scale));
  int span = int(ceil(scale));
  float zFar = 1.0;
  for (int dy = 0; dy < span; ++dy) {
    for (int dx = 0; dx < span; ++dx) {
      ivec2 sp = clamp(basePx + ivec2(dx, dy), ivec2(0), maxDepthPx);
      zFar = min(zFar, texelFetch(sceneDepth, sp, 0).r);
    }
  }
  float tScene = zFar > 0.0 ? distanceAt(fullPx, zFar) : 1e30;

  float voxel = samples[0].w;
  vec3 zero = samples[4].xyz;
  float extinction = samples[5].x, albedo = samples[5].y, unitK = samples[5].z, airK = samples[5].w;
  vec4 flicker = samples[6];

  uvec3 q = uvec3(uvec2(c), uint(F_sun.w * 60.0));
  q = q * 1664525u + 1013904223u;
  q.x += q.y * q.z; q.y += q.z * q.x; q.z += q.x * q.y;
  q ^= q >> 16u;
  q.x += q.y * q.z;
  float jitter = float(q.x & 0xffffffu) / 16777216.0;

  vec3 sunL = normalize(toLocal * F_sun.xyz);
  float phase = phaseFunction(dot(d, sunL));
  // Physically dark, neutral-cool hydrocarbon kerosene soot (zero warm peanut-butter tint against ocean spray & sky!).
  vec3 albedoRgb = albedo * vec3(0.58, 0.61, 0.66);
  float leafM = 8.0 * voxel;

  vec3 radiance = vec3(0.0);
  float through = 1.0;
  float frontDist = 1e30;
  bool litReady = false;
  vec3 sunLight = vec3(0.0), skyLight = vec3(0.0), inscatter = vec3(0.0), solar = vec3(0.0);

  // Pages are sorted front-to-back on CPU; break out of the entire volume once opaque (through < 0.003).
  for (int pi = 0; pi < pageCount && through >= 0.003; ++pi) {
    vec3 pLo = samples[PAGES_AT + 2 * pi].xyz;
    vec3 pSize = samples[PAGES_AT + 2 * pi + 1].xyz;
    vec2 t = slab(o, d, pLo, pSize);
    t.y = min(t.y, tScene);
    if (t.y <= t.x) continue;

    if (!litReady) {
      vec3 C = samples[0].xyz + axes * (pLo + 0.5 * pSize);
      vec3 sun = F_sun.xyz;
      vec3 at = (F_eye.xyz + C + F_correction.xyz) * METER_TO_LENGTH_UNIT;
      vec3 eyeAt = (F_eye.xyz + F_correction.xyz) * METER_TO_LENGTH_UNIT;
      vec3 skyIrradiance;
      vec3 sunIrradiance = GetSunAndSkyScalarIrradiance(at, sun, skyIrradiance);
      vec3 transmittance;
      inscatter = GetSkyRadianceToPoint(eyeAt, at, 0.0, sun, transmittance);
      inscatter = min(inscatter, (vec3(1.0) - transmittance) * (sunIrradiance + skyIrradiance) * RECIPROCAL_PI4 * 2.0);
      sunLight = sunIrradiance * transmittance;
      skyLight = skyIrradiance * RECIPROCAL_PI4 * transmittance;
      solar = GetSolarLuminance() * transmittance;
      litReady = true;
    }

    float dsBase = 0.75 * voxel;
    float s = t.x + jitter * dsBase;
    for (int j = 0; j < STEPS && s < t.y; ++j) {
      float ds = max(dsBase, 0.45 * F_eye.w * s);
      vec3 p = o + d * s;
      vec3 u = (p - zero) / voxel;
      bool drawn;
      vec2 v = flowAt(u, drawn);
      if (!drawn) {
        vec3 lo = zero + vec3(ivec3(floor(u)) >> 3) * leafM;
        s = max(slab(o, d, lo, vec3(leafM)).y, s) + 0.5 * ds;
        continue;
      }
      float smoke = max(v.x, 0.0);
      if (smoke > 1e-5) {
        // 3D sub-voxel volumetric billow sculpting using the already-bound Worley-Perlin noise atlas:
        // 3.2 m macro + 1.4 m fine eddies carve crisp churning soot edges on both small ocean puffs and massive plumes!
        float cellScale = 3.2;
        vec3 qS = p / cellScale;
        float lodS = max(log2(F_eye.w * s * 96.0 / cellScale), 0.0);
        float ns0 = textureLod(flowNoise, qS + vec3(0.0, 0.0, -0.42 * flicker.w / cellScale), lodS).r;
        float ns1 = textureLod(flowNoise, qS * 2.25 + vec3(0.41, 0.29, -1.05 * flicker.w / cellScale), lodS + 1.0).r;
        float billow = clamp(0.50 + (ns0 - 0.80) * 5.8 + (ns1 - 0.80) * 4.0, 0.0, 1.0);
        float resolvedS = 1.0 - smoothstep(0.5, 4.5, lodS);
        float edgeMask = 1.0 - smoothstep(0.08, 1.45, smoke);
        float sculpt = mix(0.45 + 0.82 * billow, smoothstep(0.32, 0.88, billow), edgeMask);
        smoke *= mix(1.0, sculpt, resolvedS);
      }
      float k = extinction * smoke;
      if (k > 1e-5) {
        frontDist = min(frontDist, s);
        float dtau = k * ds;
        vec2 trans = flowLightAt(u);
        vec3 scattered = albedoRgb * (sunLight * phase * trans.x + skyLight * trans.y);
        float theta = max(v.y, 0.0);
        float burning = smoothstep(0.45, 0.95, theta);
        float T = airK + unitK * theta;
        if (burning > 0.0) {
          vec3 q0 = p / flicker.z;
          float lod = max(log2(F_eye.w * s * 128.0 / flicker.z), 0.0);
          float n0 = textureLod(flowNoise, q0 + vec3(0.0, 0.0, -0.8 * flicker.w / flicker.z), lod).r;
          float n1 = textureLod(flowNoise, q0 * 1.7 + vec3(0.37, 0.71, -1.9 * flicker.w / flicker.z), lod + 0.77).r;
          float n = clamp(((n0 - 0.80) + (n1 - 0.80)) / (0.076 * 1.41421356), -3.0, 3.0);
          float resolved = 1.0 - smoothstep(0.0, 4.0, lod);
          T = mix(T, T * flicker.y * (1.0 + flicker.x * resolved * n), burning);
        }
        vec4 bb = blackbodyAt(T);
        vec3 source = scattered + (1.0 - albedo) * solar * bb.w * bb.rgb;
        float absorbed = 1.0 - exp(-dtau);
        radiance += through * absorbed * source;
        through *= 1.0 - absorbed;
        if (through < 0.003) break;
      }
      s += ds;
    }
  }

  float alpha = 1.0 - through;
  if (alpha < 1e-4) {
    imageStore(halfColorOut, c, vec4(0.0));
    imageStore(halfFrontOut, c, vec4(0.0));
    return;
  }
  vec3 perOpacity = radiance / alpha + inscatter;
  vec4 outColor = vec4((agx(perOpacity * F_night.w) + F_night.rgb) * alpha, alpha);
  imageStore(halfColorOut, c, outColor);
  imageStore(halfFrontOut, c, vec4(frontDist < 1e29 ? frontDist : 0.0, alpha, 0.0, 0.0));
}
