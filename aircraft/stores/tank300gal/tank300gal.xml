                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <sin><property>aero/alpha-rad</property></sin>
                    <abs><sin><property>aero/alpha-rad</property></sin></abs>
                    <value> 10.2100 </value>
                </product>
            </function>
        </axis>
        <axis name="SIDE">
            <function name="aero/force/fins-side">
                <description>its fins' and base's force across it, sideways</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <value> -0.27965 </value>
                    <sin><property>aero/beta-rad</property></sin>
                </product>
            </function>
            <function name="aero/coefficient/CY">
                <description>its crossflow sideways</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <sin><property>aero/beta-rad</property></sin>
                    <abs><sin><property>aero/beta-rad</property></sin></abs>
                    <value> -10.2100 </value>
                </product>
            </function>
        </axis>
        <axis name="PITCH">
            <function name="aero/moment/munk-pitch">
                <description>its body's unstable moment (Munk's couple: its card's munk_volume_m3)</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <value> 40.50451 </value>
                    <sin><product><value> 2 </value><property>aero/alpha-rad</property></product></sin>
                </product>
            </function>
            <function name="aero/moment/fins-pitch">
                <description>its fins' and base's force, behind the reference point</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <value> -2.41457 </value>
                    <sin><property>aero/alpha-rad</property></sin>
                </product>
            </function>
