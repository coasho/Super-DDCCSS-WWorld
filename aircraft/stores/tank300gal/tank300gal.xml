        <axis name="AXIAL">
            <function name="aero/coefficient/CA">
                <description>along it: a streamlined body's drag on its frontal area, its transonic rise (an estimate)</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <property>metrics/Sw-sqft</property>
                    <cos><property>aero/alpha-rad</property></cos>
                    <value> 0.0653 </value>
                    <table>
                        <independentVar>velocities/mach</independentVar>
                        <tableData>
                            0.00 1.00
                            0.80 1.00
                            0.90 1.02
                            0.95 1.07
                            1.00 1.28
                            1.05 2.12
                            1.10 2.37
                            1.20 2.43
                            1.50 2.20
                            2.00 1.80
                        </tableData>
                    </table>
                </product>
            </function>
        </axis>
        <axis name="NORMAL">
            <function name="aero/force/fins-normal">
                <description>its fins' and base's force across it (its card's side_slope_m2)</description>
                <product>
                    <property>aero/qbar-psf</property>
                    <value> 0.27965 </value>
                    <sin><property>aero/alpha-rad</property></sin>
                </product>
            </function>
            <function name="aero/coefficient/CN">
                <description>its crossflow: a cylinder's broadside drag on its planform, at its centre of pressure -0.060 m behind its CG (an estimate)</description>
