# Generated by hangar: glTF x = -y, y = up, z = forward (nose); origin at the CG.
forward -y
up +z
scale 1.0
# lifting surfaces, right half, root to tip: <kind> then per section its leading edge (body axes from the origin, m) and chord
wing 4.0590 0.0000 -0.4000 9.5000 1.3490 3.1400 -0.4000 6.6100 -3.1110 7.0500 -0.4000 1.4500
strake 5.6590 0.9000 -0.4500 4.4000 3.4590 2.5800 -0.4300 2.0000 1.4590 3.1400 -0.4000 0.1000
# jet engines by index: <bypass ratio> <afterburner 0|1>
engine 0 0.600 1
engine 1 0.600 1
# store stations: <number> <x> <y> <z> (a store's CG, body axes from the origin, m) <its bay: 0 none>
station 1 -2.8270 -5.6400 0.2000 0
station 2 -1.6390 -3.7010 0.2000 0
station 3 -0.6130 -1.7620 0.2000 0
station 4 3.5000 -1.5000 0.3000 1
station 5 1.5000 -0.2500 0.5000 2
station 6 1.5000 0.2500 0.5000 2
station 7 -1.5000 -0.2500 0.5000 3
station 8 -1.5000 0.2500 0.5000 3
station 9 3.5000 1.5000 0.3000 4
station 10 -0.6130 1.7620 0.2000 0
station 11 -1.6390 3.7010 0.2000 0
station 12 -2.8270 5.6400 0.2000 0
