# Generated by hangar: glTF x = -y, y = up, z = forward (nose); origin at the CG.
forward -y
up +z
scale 1.0
# lifting surfaces, right half, root to tip: <kind> then per section its leading edge (body axes from the origin, m) and chord
wing 4.1500 0.0000 -0.4500 6.6000 -2.4100 7.2000 -0.3500 2.1000
strake 6.1400 1.0000 -0.4800 4.2000 4.8400 1.2700 -0.4800 2.9000 3.8400 1.5550 -0.4800 1.9000 2.8400 1.9250 -0.4700 0.9500 1.8500 2.5300 -0.4500 0.0500
# jet engines by index: <bypass ratio> <afterburner 0|1>
engine 0 0.590 1
engine 1 0.590 1
# store stations: <number> <x> <y> <z> (a store's CG, body axes from the origin, m) <its bay: 0 none>
station 1 -3.5650 -7.3500 -0.3500 0
station 2 -2.2980 -5.7600 0.2300 0
station 3 -0.9890 -3.7800 0.2020 0
station 4 0.3200 -1.8000 0.1750 0
station 5 1.0000 0.0000 1.0000 0
station 6 -1.5000 0.0000 1.0000 0
station 7 0.3200 1.8000 0.1750 0
station 8 -0.9890 3.7800 0.2020 0
station 9 -2.2980 5.7600 0.2300 0
station 10 -3.5650 7.3500 -0.3500 0
# vulnerable components (MS-7g's presented areas, MS-7h's fires): <kind> <box | cylinder along x> <breakup section> <centre x y z> <half extents x y z> (body axes from the origin, m) <name>
component engine cylinder tail -4.7875 -1.1500 0.0500 2.3166 0.5458 0.5458 AL-31F L
component engine cylinder tail -4.7875 1.1500 0.0500 2.3166 0.5458 0.5458 AL-31F R
component fuel box centre 1.7500 0.0000 -0.4878 3.1000 0.5272 0.1918 fuselage forward
component fuel box centre -0.4000 0.0000 -0.4133 3.5000 0.5272 0.1865 fuselage centre
component fuel box tail -2.7500 0.0000 -0.3216 1.0500 0.5925 0.2699 fuselage aft
component crew box nose 6.5400 0.0000 -1.2000 0.2750 0.2292 0.4125 pilot
component control box left-wing -1.4977 -2.3328 -0.4176 0.3856 0.0964 0.0964 left wing flaperon
component control box right-wing -1.4977 2.3328 -0.4176 0.3856 0.0964 0.0964 right wing flaperon
component control box left-wing 0.8910 -2.5776 -0.4942 0.0310 0.0078 0.0078 left wing leading-edge flap
component control box right-wing 0.8910 2.5776 -0.4942 0.0310 0.0078 0.0078 right wing leading-edge flap
component control box tail -5.2975 -1.9913 0.1950 0.2327 0.0582 0.0582 left htail stabilator
component control box tail -5.2975 1.9912 0.1950 0.2327 0.0582 0.0582 right htail stabilator
component control box tail -4.1547 -2.2000 -1.3592 0.1781 0.0445 0.0445 left fin rudder
component control box tail -4.1547 2.2000 -1.3592 0.1781 0.0445 0.0445 right fin rudder
# chaff and flare dispensers (MS-9a, MS-7h), placed from public sources (hangar/dispensers.py TYPES): <section> <place x y z> <direction x y z> (body axes from the origin, m) <name>
dispenser tail -8.4950 -0.1751 -0.4678 0.0000 -0.5000 -0.8660 left tail boom
dispenser tail -8.4950 0.1751 -0.4678 0.0000 0.5000 -0.8660 right tail boom
