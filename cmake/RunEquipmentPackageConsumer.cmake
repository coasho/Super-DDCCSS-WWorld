# Verify equipment APIs from private installed C++, C99 and Python packages.
# Neither consumer imports source wrappers, source headers or development DLLs.
cmake_minimum_required(VERSION 3.25)
foreach(_required SOURCE_DIR BUILD_DIR TOOLCHAIN_FILE GENERATOR UCRT64_ROOT JSBSIM_DATA_DIR)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "RunEquipmentPackageConsumer: ${_required} is required")
    endif()
endforeach()
file(REAL_PATH "${BUILD_DIR}" _build)
file(REAL_PATH "${SOURCE_DIR}" _source)
set(_work "${_build}/equipment-package-consumer")
cmake_path(IS_PREFIX _build "${_work}" NORMALIZE _inside_build)
if(NOT _inside_build OR _work STREQUAL _build OR NOT IS_DIRECTORY "${_build}")
    message(FATAL_ERROR "RunEquipmentPackageConsumer: invalid private work directory: ${_work}")
endif()
if(EXISTS "${_work}")
    file(REAL_PATH "${_work}" _resolved_work)
    cmake_path(IS_PREFIX _build "${_resolved_work}" NORMALIZE _resolved_inside_build)
    if(NOT _resolved_inside_build OR _resolved_work STREQUAL _build)
        message(FATAL_ERROR "RunEquipmentPackageConsumer: private directory resolves outside the build: ${_resolved_work}")
    endif()
endif()
# The lock stays outside the disposable directory and protects repeated gate invocations.
file(LOCK "${_build}/equipment-package-consumer.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE _lock)
if(NOT _lock STREQUAL "0")
    message(FATAL_ERROR "RunEquipmentPackageConsumer: this gate is already running (${_lock})")
endif()
file(REMOVE_RECURSE "${_work}")
file(MAKE_DIRECTORY "${_work}")
set(_prefix "${_work}/installed SDK")
set(_python_prefix "${_work}/installed python")
set(_consumer_build "${_work}/consumer build")
set(_data "${_prefix}/share/flightsim")
set(_python_data "${_python_prefix}/fsim/share/flightsim")
set(_manifest "")

set(_python_record "${_build}/python/fsim-python.json")
if(NOT EXISTS "${_python_record}")
    message(FATAL_ERROR "RunEquipmentPackageConsumer: built Python SDK record missing: ${_python_record}")
endif()
file(READ "${_python_record}" _python_json)
string(JSON _python GET "${_python_json}" executable)
if(NOT EXISTS "${_python}")
    message(FATAL_ERROR "RunEquipmentPackageConsumer: recorded Python interpreter missing: ${_python}")
endif()

function(run_checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 300)
    file(WRITE "${_work}/${label}.log" "${_out}${_err}")
    if(NOT _result STREQUAL "0")
        message(FATAL_ERROR "${label} failed (${_result}); see ${_work}/${label}.log\n${_out}${_err}")
    endif()
endfunction()

foreach(_component sdk python)
    if(_component STREQUAL "sdk")
        set(_destination "${_prefix}")
    else()
        set(_destination "${_python_prefix}")
    endif()
    set(_install "${CMAKE_COMMAND}" --install "${_build}" --component "${_component}" --prefix "${_destination}")
    if(CONFIG)
        list(APPEND _install --config "${CONFIG}")
    endif()
    run_checked("install-${_component}" ${_install})
endforeach()

# Installed interfaces, DLLs and relevant aircraft/payload/store data must match their inputs byte for byte.
function(check_file source installed)
    if(NOT EXISTS "${source}" OR IS_DIRECTORY "${source}" OR NOT EXISTS "${installed}" OR IS_DIRECTORY "${installed}")
        message(FATAL_ERROR "RunEquipmentPackageConsumer: provenance file missing: ${source} -> ${installed}")
    endif()
    file(SHA256 "${source}" _source_sha)
    file(SHA256 "${installed}" _installed_sha)
    if(NOT _source_sha STREQUAL _installed_sha)
        message(FATAL_ERROR "RunEquipmentPackageConsumer: installed file differs: ${installed}")
    endif()
    file(RELATIVE_PATH _relative "${_work}" "${installed}")
    set(_manifest "${_manifest}${_installed_sha}  ${_relative}\n" PARENT_SCOPE)
endfunction()

function(check_tree source installed)
    if(NOT IS_DIRECTORY "${source}")
        message(FATAL_ERROR "RunEquipmentPackageConsumer: provenance directory missing: ${source}")
    endif()
    file(GLOB _children LIST_DIRECTORIES true RELATIVE "${source}" "${source}/*")
    foreach(_child IN LISTS _children)
        if(_child STREQUAL ".codex")
            continue()
        endif()
        if(IS_DIRECTORY "${source}/${_child}")
            check_tree("${source}/${_child}" "${installed}/${_child}")
        else()
            check_file("${source}/${_child}" "${installed}/${_child}")
        endif()
    endforeach()
    set(_manifest "${_manifest}" PARENT_SCOPE)
endfunction()

file(GLOB _headers LIST_DIRECTORIES false RELATIVE "${_source}/include/fsim" "${_source}/include/fsim/*.h")
foreach(_header IN LISTS _headers)
    check_file("${_source}/include/fsim/${_header}" "${_prefix}/include/fsim/${_header}")
endforeach()
foreach(_module __init__.py agent.py world.py)
    check_file("${_source}/python/fsim/${_module}" "${_python_prefix}/fsim/${_module}")
endforeach()
check_file("${_build}/python/fsim/_native.pyd" "${_python_prefix}/fsim/_native.pyd")
foreach(_library libfsim.dll libJSBSim.dll)
    check_file("${_build}/bin/${_library}" "${_prefix}/bin/${_library}")
    check_file("${_prefix}/bin/${_library}" "${_python_prefix}/fsim/bin/${_library}")
endforeach()
foreach(_directory aircraft engine systems)
    check_tree("${JSBSIM_DATA_DIR}/${_directory}" "${_data}/jsbsim/${_directory}")
endforeach()
foreach(_directory payloads stores)
    check_tree("${_source}/assets/${_directory}" "${_data}/${_directory}")
endforeach()
check_tree("${_source}/aircraft/stores" "${_data}/aircraft/stores")
foreach(_name f16c.xml payloads.json)
    check_file("${_source}/aircraft/f16c/${_name}" "${_data}/aircraft/f16c/${_name}")
endforeach()
# The Python package carries its own equipment runtime data; optional renderer assets are outside this gate.
foreach(_directory jsbsim payloads stores aircraft)
    check_tree("${_data}/${_directory}" "${_python_data}/${_directory}")
endforeach()
file(WRITE "${_work}/provenance.sha256" "${_manifest}")

set(_configure "${CMAKE_COMMAND}" -S "${_source}/tests/equipment_package_consumer" -B "${_consumer_build}"
    -G "${GENERATOR}" "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN_FILE}" "-DFSIM_UCRT64_ROOT=${UCRT64_ROOT}"
    "-Dfsim_DIR=${_prefix}/lib/cmake/fsim" "-DCMAKE_PREFIX_PATH=${_prefix}"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
    "-DCMAKE_BUILD_TYPE=${CONFIG}" -DCMAKE_EXPORT_COMPILE_COMMANDS=ON)
if(MAKE_PROGRAM)
    list(APPEND _configure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
run_checked(configure ${_configure})
set(_compile "${CMAKE_COMMAND}" --build "${_consumer_build}")
if(CONFIG)
    list(APPEND _compile --config "${CONFIG}")
endif()
run_checked(build ${_compile})
file(READ "${_consumer_build}/compile_commands.json" _commands)
string(JSON _command_count LENGTH "${_commands}")
if(_command_count LESS 2)
    message(FATAL_ERROR "RunEquipmentPackageConsumer: both C++ and C99 compilation records are required")
endif()
math(EXPR _last_command "${_command_count} - 1")
string(TOLOWER "${_source}/include" _forbidden_include)
string(TOLOWER "${_prefix}/include" _required_include)
foreach(_index RANGE 0 ${_last_command})
    string(JSON _command GET "${_commands}" ${_index} command)
    string(REPLACE "\\" "/" _command "${_command}")
    string(TOLOWER "${_command}" _command)
    string(FIND "${_command}" "${_forbidden_include}" _source_include)
    string(FIND "${_command}" "${_required_include}" _installed_include)
    if(NOT _source_include EQUAL -1 OR _installed_include EQUAL -1)
        message(FATAL_ERROR "RunEquipmentPackageConsumer: a consumer did not use installed headers alone")
    endif()
endforeach()

file(COPY_FILE "${_source}/tests/equipment_package_consumer/equipment_python.py" "${_work}/equipment_python.py")

function(run_native language mode)
    set(_arguments "${_prefix}")
    if(language STREQUAL "cpp")
        list(APPEND _arguments "${mode}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=FSIM_DLL_DIR --unset=PYTHONPATH --unset=PYTHONHOME
        "FSIM_AIRCRAFT_PATH=${_data}/aircraft;${_data}/aircraft/stores"
        "PATH=${_prefix}/bin;$ENV{SystemRoot}/System32;$ENV{SystemRoot}"
        "${_prefix}/bin/equipment_consumer_${language}.exe" ${_arguments}
        WORKING_DIRECTORY "${_work}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
    file(WRITE "${_work}/run-${language}-${mode}.log" "${_out}${_err}")
    set(_consumer_result "${_result}" PARENT_SCOPE)
    set(_consumer_output "${_out}${_err}" PARENT_SCOPE)
endfunction()

function(run_python mode)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=FSIM_DLL_DIR --unset=PYTHONHOME
        "FSIM_AIRCRAFT_PATH=${_python_data}/aircraft;${_python_data}/aircraft/stores"
        "PYTHONPATH=${_python_prefix}" "PATH=$ENV{SystemRoot}/System32;$ENV{SystemRoot}"
        "${_python}" -s -B "${_work}/equipment_python.py" "${_python_prefix}" "${mode}"
        WORKING_DIRECTORY "${_work}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
    file(WRITE "${_work}/run-python-${mode}.log" "${_out}${_err}")
    set(_consumer_result "${_result}" PARENT_SCOPE)
    set(_consumer_output "${_out}${_err}" PARENT_SCOPE)
endfunction()

function(expect_result label expected)
    if(NOT _consumer_result STREQUAL "${expected}")
        message(FATAL_ERROR "installed equipment ${label}: expected ${expected}, got ${_consumer_result}\n${_consumer_output}")
    endif()
    message(STATUS "installed equipment ${label}: expected exit ${expected}\n${_consumer_output}")
endfunction()

foreach(_language cpp c)
    run_native("${_language}" smoke)
    expect_result("${_language} smoke" 0)
endforeach()
run_python(smoke)
expect_result("python smoke" 0)

# A present but corrupt installed model must be rejected, proving the consumers do not silently load source/build data.
# Restore the private installed file before checking the outcome, including when the consumer fails or times out.
foreach(_language cpp python)
    if(_language STREQUAL "cpp")
        set(_probe "${_data}/aircraft/f16c/f16c.xml")
    else()
        set(_probe "${_python_data}/aircraft/f16c/f16c.xml")
    endif()
    file(COPY_FILE "${_probe}" "${_probe}.probe-backup")
    file(WRITE "${_probe}" "<not-a-valid-jsbsim-model/>\n")
    if(_language STREQUAL "cpp")
        run_native(cpp data_probe)
    else()
        run_python(data_probe)
    endif()
    file(COPY_FILE "${_probe}.probe-backup" "${_probe}")
    file(REMOVE "${_probe}.probe-backup")
    expect_result("${_language} installed-data probe (restored)" 42)
endforeach()
run_native(cpp smoke)
expect_result("cpp smoke after restoration" 0)
run_python(smoke)
expect_result("python smoke after restoration" 0)
message(STATUS "Installed equipment C++, C99 and Python consumers passed; provenance: ${_work}/provenance.sha256")
