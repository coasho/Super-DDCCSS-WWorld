# Lightweight regression for dist's target graph and generated output ownership.
# Compiles tiny standalone targets in D:/ENV/tmp; never touches native build files.
cmake_minimum_required(VERSION 3.25)
foreach(_required SOURCE_DIR TOOLCHAIN_FILE UCRT64_ROOT)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "TestDistComponents: ${_required} is required")
    endif()
endforeach()
if(NOT GENERATOR)
    set(GENERATOR Ninja)
endif()
if(NOT FIXTURE_ROOT)
    set(FIXTURE_ROOT "D:/ENV/tmp")
endif()
file(REAL_PATH "${FIXTURE_ROOT}" _fixture_root)
if(NOT _fixture_root MATCHES "^[Dd]:/")
    message(FATAL_ERROR "TestDistComponents: fixture must stay on D: ${_fixture_root}")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _suffix)
set(_work "${_fixture_root}/fsim-dist-components-${_suffix}")
set(_source "${_work}/source")
set(_build "${_work}/build")
file(MAKE_DIRECTORY "${_source}/cmake" "${_source}/include/fsim" "${_source}/docs/sdk"
    "${_source}/assets/payloads" "${_source}/assets/stores" "${_source}/aircraft"
    "${_source}/examples/simulation/scenarios" "${_source}/third_party/jsbsim")
foreach(_module Install.cmake StageDesigns.cmake CleanDist.cmake fsimConfig.cmake.in)
    file(COPY "${SOURCE_DIR}/cmake/${_module}" DESTINATION "${_source}/cmake")
endforeach()
# Optional override lets the same regression establish a red result against the
# previous installation rules, without replacing any repository files.
if(INSTALL_MODULE)
    file(COPY_FILE "${INSTALL_MODULE}" "${_source}/cmake/Install.cmake")
endif()
file(WRITE "${_source}/cmake/RuntimeDeps.cmake" "function(fsim_copy_runtime_deps)\nendfunction()\n")
file(WRITE "${_source}/cmake/JsbsimPatches.cmake" "# fixture\n")
file(WRITE "${_source}/include/fsim/fixture.h" "#pragma once\n")
file(WRITE "${_source}/docs/sdk/fixture.md" "Fixture SDK.\n")
file(WRITE "${_source}/assets/payloads/fixture.json" "{}\n")
file(WRITE "${_source}/assets/stores/fixture.json" "{}\n")
file(WRITE "${_source}/examples/simulation/scenarios/fixture.json" "{}\n")
file(WRITE "${_source}/third_party/jsbsim/COPYING" "Fixture license.\n")
file(WRITE "${_source}/aircraft/fixture/fixture.xml" "<fixture/>\n")
file(WRITE "${_source}/library.cpp" "extern \"C\" __declspec(dllexport) int fixture() { return 0; }\n")
file(WRITE "${_source}/main.cpp" "int main() { return 0; }\n")
foreach(_dir aircraft engine systems)
    file(MAKE_DIRECTORY "${_source}/jsbsim/${_dir}")
    file(WRITE "${_source}/jsbsim/${_dir}/fixture.txt" "fixture\n")
endforeach()
file(WRITE "${_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.25)
project(dist_fixture VERSION 0.1.0 LANGUAGES CXX)
option(FIXTURE_EXAMPLES "Enable an example target" ON)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
set(FSIM_JSBSIM_DATA_DIR "${CMAKE_SOURCE_DIR}/jsbsim")
add_library(fsim SHARED library.cpp)
add_executable(flightsim main.cpp)
add_custom_target(deploy)
add_dependencies(deploy fsim flightsim)
if(FIXTURE_EXAMPLES)
    add_executable(minimal_trainer main.cpp)
    set_target_properties(minimal_trainer PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/examples")
endif()
foreach(_file models/FGLGear.cpp models/FGAccelerations.cpp models/propulsion/FGRotor.h
        models/propulsion/FGRotor.cpp models/propulsion/FGElectric.cpp models/propulsion/FGPropeller.cpp
        models/propulsion/FGTransmission.h models/flight_control/FGActuator.cpp models/FGAerodynamics.cpp
        models/FGMassBalance.cpp models/FGAuxiliary.cpp)
    file(WRITE "${CMAKE_BINARY_DIR}/third_party/jsbsim-patched/${_file}" "// fixture\n")
endforeach()
include(cmake/Install.cmake)
]=])
function(checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    file(WRITE "${_work}/${label}.log" "${_out}${_err}")
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "${label} failed (${_result}); logs at ${_work}\n${_out}${_err}")
    endif()
endfunction()
set(_configure "${CMAKE_COMMAND}" -S "${_source}" -B "${_build}" -G "${GENERATOR}"
    "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN_FILE}" "-DFSIM_UCRT64_ROOT=${UCRT64_ROOT}" -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_INSTALL_BINDIR=executables -DCMAKE_INSTALL_DATADIR=data)
if(MAKE_PROGRAM)
    list(APPEND _configure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
checked(configure-enabled ${_configure} -DFIXTURE_EXAMPLES=ON)
# Directly building dist must compile the example: no prebuild masks dependency omissions.
checked(dist-enabled "${CMAKE_COMMAND}" --build "${_build}" --target dist --config Release)
if(NOT EXISTS "${_build}/dist/examples/bin/minimal_trainer.exe")
    message(FATAL_ERROR "enabled example was not built and installed by dist")
endif()
# The runtime layout is deliberately fixed even when GNUInstallDirs is
# customized. Exported paths must describe the actual installed bin/share.
set(_consumer_source "${_work}/consumer")
file(WRITE "${_consumer_source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.25)
project(dist_fixture_consumer LANGUAGES NONE)
find_package(fsim CONFIG REQUIRED COMPONENTS sdk)
if(NOT TARGET fsim::sdk)
    message(FATAL_ERROR "installed SDK target is missing")
endif()
if(NOT fsim_BIN_DIR STREQUAL "${EXPECTED_PREFIX}/bin")
    message(FATAL_ERROR "SDK bin path does not match fixed installed layout: ${fsim_BIN_DIR}")
endif()
if(NOT fsim_DATA_DIR STREQUAL "${EXPECTED_PREFIX}/share/flightsim")
    message(FATAL_ERROR "SDK data path does not match fixed installed layout: ${fsim_DATA_DIR}")
endif()
if(NOT fsim_JSBSIM_ROOT STREQUAL "${fsim_DATA_DIR}/jsbsim" OR
   NOT fsim_AIRCRAFT_DIR STREQUAL "${fsim_DATA_DIR}/aircraft")
    message(FATAL_ERROR "SDK runtime roots do not follow installed data path")
endif()
]=])
set(_consumer_configure "${CMAKE_COMMAND}" -S "${_consumer_source}" -B "${_work}/consumer build"
    -G "${GENERATOR}"
    "-Dfsim_DIR=${_build}/dist/sdk/lib/cmake/fsim" "-DEXPECTED_PREFIX=${_build}/dist/sdk"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF)
if(MAKE_PROGRAM)
    list(APPEND _consumer_configure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
checked(configure-consumer ${_consumer_configure})
file(WRITE "${_build}/dist/examples/obsolete-example.exe" "obsolete\n")
file(WRITE "${_build}/dist/examples/maps/obsolete.tile" "obsolete\n")
file(WRITE "${_build}/dist/python/obsolete.whl" "obsolete\n")
file(WRITE "${_build}/dist/python/maps/obsolete.tile" "obsolete\n")
file(WRITE "${_build}/dist/viewer/bin/obsolete-viewer.exe" "obsolete\n")
file(WRITE "${_build}/dist/viewer/maps/keep.tile" "cached map\n")
checked(configure-disabled ${_configure} -DFIXTURE_EXAMPLES=OFF)
checked(dist-disabled "${CMAKE_COMMAND}" --build "${_build}" --target dist --config Release)
foreach(_obsolete dist/examples/bin/minimal_trainer.exe dist/examples/obsolete-example.exe
        dist/examples/maps/obsolete.tile dist/python/obsolete.whl dist/python/maps/obsolete.tile
        dist/viewer/bin/obsolete-viewer.exe)
    if(EXISTS "${_build}/${_obsolete}")
        message(FATAL_ERROR "inactive component retained generated output: ${_obsolete}")
    endif()
endforeach()
if(NOT EXISTS "${_build}/dist/viewer/maps/keep.tile")
    message(FATAL_ERROR "inactive viewer cleanup deleted its reusable maps cache")
endif()
# The ownership guard must reject a target outside this fixture's build/dist.
file(WRITE "${_work}/unowned/keep.txt" "must survive\n")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DDIR=${_work}/unowned" "-DBUILD_ROOT=${_build}"
    -P "${_source}/cmake/CleanDist.cmake" RESULT_VARIABLE _guard OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
file(WRITE "${_work}/ownership-guard.log" "${_out}${_err}")
if(_guard EQUAL 0 OR NOT EXISTS "${_work}/unowned/keep.txt")
    message(FATAL_ERROR "dist cleanup ownership guard did not protect an unrelated directory")
endif()
message(STATUS "dist regression passed: enabled target built, fixed SDK paths exported, inactive outputs cleaned, maps retained, ownership enforced")
message(STATUS "fixture logs: ${_work}")
