# One source of equipment identities for the native registry, generator and UI.
set(_fsim_equipment_catalogue "${CMAKE_SOURCE_DIR}/tools/models/hangar/hangar/data/equipment_models.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_fsim_equipment_catalogue}"
    "${CMAKE_SOURCE_DIR}/src/contracts/equipment/EquipmentModels.h.in"
    "${CMAKE_SOURCE_DIR}/src/contracts/equipment/EquipmentModels.h")
file(READ "${_fsim_equipment_catalogue}" _fsim_equipment_json)
string(JSON _fsim_equipment_schema GET "${_fsim_equipment_json}" schema_version)
if(NOT _fsim_equipment_schema EQUAL 1)
    message(FATAL_ERROR "Unsupported equipment catalogue format")
endif()
string(JSON FSIM_EQUIPMENT_MODEL_COUNT LENGTH "${_fsim_equipment_json}" models)
if(FSIM_EQUIPMENT_MODEL_COUNT LESS 1)
    message(FATAL_ERROR "Equipment catalogue must not be empty")
endif()
function(_fsim_equipment_quote value output)
    string(REPLACE "\\" "\\\\" _quoted "${value}")
    string(REPLACE "\"" "\\\"" _quoted "${_quoted}")
    string(REPLACE "\n" "\\n" _quoted "${_quoted}")
    string(REPLACE "\r" "\\r" _quoted "${_quoted}")
    set(${output} "\"${_quoted}\"" PARENT_SCOPE)
endfunction()
set(FSIM_EQUIPMENT_MODEL_ROWS "")
set(FSIM_EQUIPMENT_COMPONENT_ROWS "")
set(FSIM_EQUIPMENT_COMPONENT_COUNT 0)
math(EXPR _fsim_equipment_last "${FSIM_EQUIPMENT_MODEL_COUNT} - 1")
foreach(_i RANGE 0 ${_fsim_equipment_last})
    string(JSON _model GET "${_fsim_equipment_json}" models ${_i})
    set(_row "")
    foreach(_field IN ITEMS store_id model_id designation card_designation native_model)
        string(JSON _value GET "${_model}" ${_field})
        _fsim_equipment_quote("${_value}" _literal)
        string(APPEND _row "${_literal},")
    endforeach()
    string(APPEND FSIM_EQUIPMENT_MODEL_ROWS "    {${_row}},\n")
    string(JSON _store GET "${_model}" store_id)
    string(JSON _identity GET "${_model}" model_id)
    foreach(_kind IN ITEMS seeker guidance autopilot allocator actuator fuze warhead propulsion aerodynamics)
        string(JSON _part GET "${_model}" components ${_kind})
        string(JSON _availability GET "${_part}" availability)
        if(_availability STREQUAL "available")
            set(_row "")
            foreach(_value IN ITEMS "${_store}" "${_identity}" "${_kind}")
                _fsim_equipment_quote("${_value}" _literal)
                string(APPEND _row "${_literal},")
            endforeach()
            foreach(_field IN ITEMS selector mechanism_id name)
                string(JSON _value GET "${_part}" ${_field})
                _fsim_equipment_quote("${_value}" _literal)
                string(APPEND _row "${_literal},")
            endforeach()
            string(APPEND FSIM_EQUIPMENT_COMPONENT_ROWS "    {${_row}},\n")
            math(EXPR FSIM_EQUIPMENT_COMPONENT_COUNT "${FSIM_EQUIPMENT_COMPONENT_COUNT} + 1")
        endif()
    endforeach()
endforeach()
set(_fsim_equipment_header "${CMAKE_SOURCE_DIR}/src/contracts/equipment/EquipmentModels.h")
file(READ "${_fsim_equipment_header}.in" _fsim_equipment_template)
string(CONFIGURE "${_fsim_equipment_template}" _fsim_equipment_generated @ONLY)
if(FSIM_WRITE_EQUIPMENT_MODELS)
    file(WRITE "${_fsim_equipment_header}" "${_fsim_equipment_generated}")
else()
    file(READ "${_fsim_equipment_header}" _fsim_equipment_committed)
    if(NOT _fsim_equipment_generated STREQUAL _fsim_equipment_committed)
        message(FATAL_ERROR "Stale equipment model header. Run cmake -DFSIM_WRITE_EQUIPMENT_MODELS=ON -P cmake/EquipmentModels.cmake from the source root, then review both catalogue and generated header.")
    endif()
endif()
