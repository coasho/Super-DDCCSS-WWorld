# Install just the SDK into a private prefix, then build/run a separate consumer.
# This gate never changes the source tree or uses development DLLs on PATH.
cmake_minimum_required(VERSION 3.25)
foreach(_required SOURCE_DIR BUILD_DIR TOOLCHAIN_FILE GENERATOR JSBSIM_DATA_DIR UCRT64_ROOT)
    if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
        message(FATAL_ERROR "RunPackageConsumer: ${_required} is required")
    endif()
endforeach()
file(REAL_PATH "${BUILD_DIR}" _build)
set(_work "${_build}/package-consumer")
# The sole removable directory is a child owned by this gate, never a caller's prefix.
cmake_path(IS_PREFIX _build "${_work}" NORMALIZE _inside_build)
if(NOT _inside_build OR _work STREQUAL _build OR NOT IS_DIRECTORY "${_build}")
    message(FATAL_ERROR "RunPackageConsumer: invalid private work directory: ${_work}")
endif()
file(REMOVE_RECURSE "${_work}")
set(_prefix "${_work}/installed SDK")
set(_consumer_build "${_work}/consumer build")
set(_data "${_prefix}/share/flightsim")
file(MAKE_DIRECTORY "${_work}")

function(run_checked label)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    file(WRITE "${_work}/${label}.log" "${_out}${_err}")
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "${label} failed (${_result}); see ${_work}/${label}.log\n${_out}${_err}")
    endif()
endfunction()
set(_install "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --component sdk --prefix "${_prefix}")
if(CONFIG)
    list(APPEND _install --config "${CONFIG}")
endif()
run_checked(install ${_install})

# Match every installed runtime file to the source/staged bytes. Directory-only
# checks could otherwise accept a partial install or a stale package.
set(_manifest "")
function(check_file source installed)
    if(NOT EXISTS "${installed}" OR IS_DIRECTORY "${installed}")
        message(FATAL_ERROR "SDK runtime data missing: ${installed}")
    endif()
    file(SHA256 "${source}" _source_sha)
    file(SHA256 "${installed}" _installed_sha)
    if(NOT _source_sha STREQUAL _installed_sha)
        message(FATAL_ERROR "SDK runtime data differs: ${installed}")
    endif()
    file(RELATIVE_PATH _relative "${_prefix}" "${installed}")
    set(_manifest "${_manifest}${_installed_sha}  ${_relative}\n" PARENT_SCOPE)
endfunction()
macro(check_tree source installed)
    file(GLOB_RECURSE _files LIST_DIRECTORIES false RELATIVE "${source}" "${source}/*")
    if(NOT _files)
        message(FATAL_ERROR "SDK runtime source tree is empty: ${source}")
    endif()
    foreach(_file IN LISTS _files)
        check_file("${source}/${_file}" "${installed}/${_file}")
    endforeach()
endmacro()
foreach(_dir aircraft engine systems)
    check_tree("${JSBSIM_DATA_DIR}/${_dir}" "${_data}/jsbsim/${_dir}")
endforeach()
foreach(_dir payloads stores)
    check_tree("${SOURCE_DIR}/assets/${_dir}" "${_data}/${_dir}")
endforeach()
file(GLOB _designs LIST_DIRECTORIES true "${SOURCE_DIR}/aircraft/*")
foreach(_design IN LISTS _designs)
    get_filename_component(_name "${_design}" NAME)
    if(NOT EXISTS "${_design}/${_name}.xml" AND NOT EXISTS "${_design}/${_name}.glb")
        continue()
    endif()
    foreach(_file "${_name}.xml" "${_name}.glb" "${_name}.glb.manifest" "payloads.json" "rcs.bin" "${_name}.damage.json")
        if(EXISTS "${_design}/${_file}")
            check_file("${_design}/${_file}" "${_data}/aircraft/${_name}/${_file}")
        endif()
    endforeach()
    foreach(_dir Engines pieces)
        if(IS_DIRECTORY "${_design}/${_dir}")
            check_tree("${_design}/${_dir}" "${_data}/aircraft/${_name}/${_dir}")
        endif()
    endforeach()
endforeach()
check_tree("${SOURCE_DIR}/aircraft/stores" "${_data}/aircraft/stores")
check_file("${SOURCE_DIR}/aircraft/models.txt" "${_data}/aircraft/models.txt")
check_file("${SOURCE_DIR}/third_party/jsbsim/COPYING" "${_prefix}/share/doc/flightsim/LICENSE-JSBSim.txt")
if(EXISTS "${_prefix}/bin/libfsim_vision.dll")
    foreach(_dir models)
        check_tree("${BUILD_DIR}/share/flightsim/${_dir}" "${_data}/${_dir}")
    endforeach()
    check_tree("${SOURCE_DIR}/assets/clouds" "${_data}/clouds")
endif()
file(WRITE "${_work}/runtime-data.sha256" "${_manifest}")

set(_configure "${CMAKE_COMMAND}" -S "${SOURCE_DIR}/tests/compatibility/package_consumer" -B "${_consumer_build}"
    -G "${GENERATOR}" "-DCMAKE_TOOLCHAIN_FILE=${TOOLCHAIN_FILE}" "-DFSIM_UCRT64_ROOT=${UCRT64_ROOT}"
    "-Dfsim_DIR=${_prefix}/lib/cmake/fsim" "-DCMAKE_PREFIX_PATH=${_prefix}"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
    "-DCMAKE_BUILD_TYPE=${CONFIG}")
if(MAKE_PROGRAM)
    list(APPEND _configure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
run_checked(configure ${_configure})
set(_compile "${CMAKE_COMMAND}" --build "${_consumer_build}" --target consumer)
if(CONFIG)
    list(APPEND _compile --config "${CONFIG}")
endif()
run_checked(build ${_compile})

set(_exe "${_prefix}/bin/consumer.exe")
set(_env "FSIM_AIRCRAFT_PATH=${_data}/aircraft;${_data}/aircraft/stores")
function(run_consumer mode expected)
    # Only installed bin and Windows system directories participate in DLL lookup.
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "${_env}" "PATH=${_prefix}/bin;$ENV{SystemRoot}/System32;$ENV{SystemRoot}"
        "${_exe}" "${_prefix}" "${mode}"
        WORKING_DIRECTORY "${_work}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    file(WRITE "${_work}/run-${mode}.log" "${_out}${_err}")
    if(NOT _result STREQUAL "${expected}")
        message(FATAL_ERROR "installed consumer ${mode}: expected ${expected}, got ${_result}\n${_out}${_err}")
    endif()
    message(STATUS "installed consumer ${mode}: expected exit ${expected}\n${_out}")
endfunction()
run_consumer(smoke 0)
foreach(_probe stock design weapon)
    if(_probe STREQUAL "stock")
        set(_file "${_data}/jsbsim/aircraft/c172x/c172x.xml")
    elseif(_probe STREQUAL "design")
        set(_file "${_data}/aircraft/f16c/f16c.xml")
    else()
        set(_file "${_data}/aircraft/stores/mk82/mk82.xml")
    endif()
    # Keep the selected path present so the resolver cannot choose a source
    # fallback. Restore the exact installed bytes even when the probe fails.
    file(COPY_FILE "${_file}" "${_file}.probe-backup")
    file(WRITE "${_file}" "<not-a-valid-jsbsim-model/>\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "${_env}"
        "PATH=${_prefix}/bin;$ENV{SystemRoot}/System32;$ENV{SystemRoot}"
        "${_exe}" "${_prefix}" "${_probe}"
        WORKING_DIRECTORY "${_work}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
    file(COPY_FILE "${_file}.probe-backup" "${_file}")
    file(REMOVE "${_file}.probe-backup")
    file(WRITE "${_work}/probe-${_probe}.log" "${_out}${_err}")
    if(NOT _result STREQUAL "42")
        message(FATAL_ERROR "installed ${_probe} data probe expected API load rejection 42, got ${_result}\n${_out}${_err}")
    endif()
    message(STATUS "installed ${_probe} data probe: API load rejection 42 (restored)")
endforeach()
run_consumer(smoke 0)
message(STATUS "SDK-only installed consumer passed; data manifest: ${_work}/runtime-data.sha256")
