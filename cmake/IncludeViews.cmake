# Include views (ARCH-03 task 5; docs/architecture/validation/arch-03-foundation-and-leaves.md).
#
# A migrated module's headers are spelled from src ("foundation/core/Log.h"), but handing a target the whole src root
# would make every other module's private headers visible to its compiler as well. Instead each migrated target
# exports a view: a directory under the build tree that mirrors only its own headers at their src-relative paths, each
# a one-line forwarder to the real file. A target compiles with its own view and the views its declared (linked)
# providers export, so a header outside that closure is not found. Include spelling, __FILE__, include guards and the
# compiled code are unchanged: a forwarder names the real header by the same absolute path the src root produced.
#
# fsim_include_view(<target>)
#   Mirrors every header under the calling directory into ${CMAKE_BINARY_DIR}/include-views/<target> and adds that
#   view to the target's include directories (PUBLIC, or INTERFACE for an interface library). A header added or
#   removed re-runs CMake (CONFIGURE_DEPENDS); forwarders whose header is gone are removed, and an unchanged forwarder
#   is not rewritten, so its timestamp triggers no rebuild.
function(fsim_include_view target)
    set(_src "${CMAKE_SOURCE_DIR}/src")
    set(_view "${CMAKE_BINARY_DIR}/include-views/${target}")
    file(RELATIVE_PATH _module "${_src}" "${CMAKE_CURRENT_SOURCE_DIR}")
    if(_module MATCHES "^\\.\\." OR IS_ABSOLUTE "${_module}" OR _module STREQUAL "")
        message(FATAL_ERROR "fsim_include_view(${target}): ${CMAKE_CURRENT_SOURCE_DIR} is not a module under src")
    endif()
    file(GLOB_RECURSE _headers CONFIGURE_DEPENDS RELATIVE "${_src}" "${CMAKE_CURRENT_SOURCE_DIR}/*.h")
    if(NOT _headers)
        message(FATAL_ERROR "fsim_include_view(${target}): no headers under ${CMAKE_CURRENT_SOURCE_DIR}")
    endif()
    foreach(_h IN LISTS _headers)
        file(CONFIGURE OUTPUT "${_view}/${_h}"
             CONTENT "// Generated by cmake/IncludeViews.cmake: ${target}'s include view. Do not edit.\n#include \"${_src}/${_h}\"\n"
             @ONLY NEWLINE_STYLE LF)
    endforeach()
    file(GLOB_RECURSE _present RELATIVE "${_view}" "${_view}/*")
    foreach(_f IN LISTS _present)
        if(NOT _f IN_LIST _headers)
            file(REMOVE "${_view}/${_f}")
        endif()
    endforeach()
    get_target_property(_type ${target} TYPE)
    if(_type STREQUAL "INTERFACE_LIBRARY")
        set(_scope INTERFACE)
    else()
        set(_scope PUBLIC)
    endif()
    target_include_directories(${target} ${_scope} "$<BUILD_INTERFACE:${_view}>")
    set_property(TARGET ${target} PROPERTY FSIM_INCLUDE_VIEW "${_view}")
endfunction()
