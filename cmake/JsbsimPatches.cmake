// flightsim patch (cmake/JsbsimPatches.cmake): a reset restarts the rotor as
// a load does - at rest if a transmission drives it - and the next
// calculation converges its inflow and ground-height filter.
void FGRotor::ResetToIC(void)
{
  FGThruster::ResetToIC();
  FreshStart = true;
  if (!ExternalRPM) {
    RPM = 0.0;
    Transmission->SetEngineRPM(0.0);
    Transmission->SetThrusterRPM(0.0);
    Transmission->ResetFreeWheel(dt);
  }
}
]=])
_fsim_jsbsim_edit(_text _old _new FGRotor.cpp "reset")
set(_old [=[  GroundEffectShift = ConfigValueConv(rotor_element, "groundeffectshift", 0.0, "FT");
]=])
set(_new [=[  GroundEffectShift = ConfigValueConv(rotor_element, "groundeffectshift", 0.0, "FT");

  // flightsim patch: the force model - heffley (upstream's) or classical
  if (Element* model_el = rotor_element->FindElement("model")) {
    string model = rotor_element->FindElementValue("model");
    model = to_upper(model);
    if (model == "CLASSICAL") {
      ClassicalModel = true;
    } else if (model != "HEFFLEY") {
      FGXMLLogging log(model_el, LogLevel::ERROR);
      log << "# unknown rotor model: '" << model << "' using heffley.\n";
    }
  }
]=])
