# Fixes to JSBSim that flightsim carries.
#
# The vendored source stays unchanged. Each fixed file is
# generated into the build tree - the upstream source with the edits below,
# each marked "flightsim patch" in the code - and compiled in place of the
# original (JSBSim is LGPL-2.1; see THIRD_PARTY_NOTICES.md). Every edit names
# the exact text it replaces: if upstream JSBSim no longer has it, configuring
# stops, so the fix is reviewed rather than silently lost.

set(_fsim_jsbsim_patched ${CMAKE_BINARY_DIR}/third_party/jsbsim-patched)

# Replace the one occurrence of the text in variable `old_var` with the text in
# `new_var`, inside variable `text_var`.
function(_fsim_jsbsim_edit text_var old_var new_var file what)
    string(FIND "${${text_var}}" "${${old_var}}" _at)
    if(_at EQUAL -1)
        message(FATAL_ERROR "JSBSim fix '${what}' no longer applies to ${file}: upstream changed it. "
                            "Review cmake/JsbsimPatches.cmake.")
    endif()
    string(FIND "${${text_var}}" "${${old_var}}" _last REVERSE)
    if(NOT _last EQUAL _at)
        message(FATAL_ERROR "JSBSim fix '${what}' names text that ${file} has more than once: "
                            "widen it in cmake/JsbsimPatches.cmake until it is unique.")
    endif()
    string(REPLACE "${${old_var}}" "${${new_var}}" _text "${${text_var}}")
    set(${text_var} "${_text}" PARENT_SCOPE)
endfunction()

# ---------------------------------------------------------------------------
# models/FGLGear.cpp: a wheel on its side.
#
# A wheel's (BOGEY) strut is projected on the ground normal three times: its
# compression and compression speed are divided by the cosine of the strut's
# angle to the normal, and so is the ground force. As the strut turns towards
# the ground plane - a wheel meeting the ground sideways, as in a cartwheel -
# the force grows as 1/cos^2 without bound (0/0, NaN, with the strut parallel
# to the ground), and the aircraft is thrown back into the air or blows up:
# the stock c172x reached 9600 m/s. The projection is bounded at 45 degrees,
# so nothing changes while a strut is within 45 degrees of the ground normal.
# ---------------------------------------------------------------------------
set(_src ${FSIM_JSBSIM_SOURCE_DIR}/src/models/FGLGear.cpp)
file(READ ${_src} _text)
string(REPLACE "\r\n" "\n" _text "${_text}")

set(_old [=[namespace JSBSim {
]=])
set(_new [=[namespace JSBSim {

// flightsim patch (cmake/JsbsimPatches.cmake): the smallest projection of a
// wheel's strut on the ground normal used to turn its compression and force
// into the ground's frame - cos(45 deg). Below it, dividing by the projection
// made the ground force grow without bound as a wheel met the ground sideways.
static const double kMinStrutProjection = 0.70710678118654752;
]=])
_fsim_jsbsim_edit(_text _old _new ${_src} "the bound")

set(_old [=[      LGearProj = -(mTGear.Transposed() * vGroundNormal)(eZ);
]=])
set(_new [=[      LGearProj = -(mTGear.Transposed() * vGroundNormal)(eZ);
      // flightsim patch: bounded, see kMinStrutProjection
      if (LGearProj > 0.0) LGearProj = max(LGearProj, kMinStrutProjection);
]=])
_fsim_jsbsim_edit(_text _old _new ${_src} "compression")

set(_old [=[        if (eContactType == ctBOGEY)
          compressSpeed /= LGearProj;
]=])
set(_new [=[        if (eContactType == ctBOGEY) // flightsim patch: no 0/0 with the strut along the ground
          compressSpeed = LGearProj > 0.0 ? compressSpeed / LGearProj : 0.0;
]=])
_fsim_jsbsim_edit(_text _old _new ${_src} "compression speed")

set(_old [=[    vFn(eZ) = StrutForce / (mTGear.Transposed()*vGroundNormal)(eZ);
]=])
set(_new [=[    // flightsim patch: the projection bounded as for the compression; a
    // strut pointing away from the ground pushes on nothing
    {
      const double proj = (mTGear.Transposed()*vGroundNormal)(eZ);
      vFn(eZ) = proj < 0.0 ? StrutForce / min(proj, -kMinStrutProjection) : 0.0;
    }
]=])
_fsim_jsbsim_edit(_text _old _new ${_src} "ground force")

set(_dst ${_fsim_jsbsim_patched}/models/FGLGear.cpp)
file(WRITE ${_dst}.new "// Generated by flightsim from JSBSim's src/models/FGLGear.cpp with the fixes\n"
                       "// in cmake/JsbsimPatches.cmake (marked \"flightsim patch\"). Do not edit.\n${_text}")
configure_file(${_dst}.new ${_dst} COPYONLY) # rewritten only when it changes: no needless rebuilds
file(REMOVE ${_dst}.new)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${_src})

get_target_property(_srcs Models SOURCES)
list(TRANSFORM _srcs REPLACE "(^|.*/)FGLGear\\.cpp$" "${_dst}")
set_property(TARGET Models PROPERTY SOURCES ${_srcs})
target_include_directories(Models PRIVATE ${FSIM_JSBSIM_SOURCE_DIR}/src/models) # its #include "FGLGear.h"

# Write the text of variable `text_var`, JSBSim's src/<rel> with fixes, into
# the build tree; with a target, compile it in place of the original.
function(_fsim_jsbsim_write rel text_var target)
    set(_dst ${_fsim_jsbsim_patched}/${rel})
    file(WRITE ${_dst}.new "// Generated by flightsim from JSBSim's src/${rel} with the fixes\n"
                           "// in cmake/JsbsimPatches.cmake (marked \"flightsim patch\"). Do not edit.\n${${text_var}}")
    configure_file(${_dst}.new ${_dst} COPYONLY)
    file(REMOVE ${_dst}.new)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${FSIM_JSBSIM_SOURCE_DIR}/src/${rel})
    if(target)
        get_filename_component(_name ${rel} NAME)
        string(REPLACE "." "\\." _name_re ${_name})
        get_target_property(_srcs ${target} SOURCES)
        list(TRANSFORM _srcs REPLACE "(^|.*/)${_name_re}$" "${_dst}")
        set_property(TARGET ${target} PROPERTY SOURCES ${_srcs})
    endif()
endfunction()

function(_fsim_jsbsim_read rel text_var)
    file(READ ${FSIM_JSBSIM_SOURCE_DIR}/src/${rel} _t)
    string(REPLACE "\r\n" "\n" _t "${_t}")
    set(${text_var} "${_t}" PARENT_SCOPE)
endfunction()

# ---------------------------------------------------------------------------
# models/propulsion/FGRotor.h and FGRotor.cpp: a rotor after a reset, and the
# classical rotor forces.
#
# 1. A reset started a rotor from what the previous run left: FGRotor has no
#    ResetToIC, so its inflow, its ground-height filter and a transmission's
#    rpm carried over, and what a reset did depended on what ran before it.
#    And a start began the inflow at lambda = -0.001, whose first update
#    divides the thrust by 2|lambda|: a UH-1H's tail rotor reached C_T = -0.17
#    in it. Now a reset restarts a rotor as a load does (at rest if a
#    transmission drives it), and the first calculation after either converges
#    the inflow, and the ground-height filter, at the state it starts from.
# 2. <model> classical </model> in a rotor's file (default: heffley, upstream's
#    forms) computes the in-plane forces and the torque from the classical
#    blade-element force expressions NASA TM-73254 flies (Talbot and Corliss
#    1977, eq. 1-3). Upstream's minimum-complexity forms (thrust times a flapping
#    angle) leave a UH-1H unstable in angle of attack at 60 kt where the
#    classical ones, and its flight records, are stable (docs/rotorcraft.md).
#    In that model the ground effect scales the inflow's steady state
#    (TM-73254 eq. 10a); upstream's scales the inflow state every step, which
#    compounds with the step and the inflow lag.
# Upstream's own rotorcraft (the AH-1S) keep upstream's forces: only the reset
# changes for them. FGEngine.cpp and FGTurboProp.cpp include FGRotor.h, so they
# are compiled from the build tree too, unchanged, against the changed header.
# ---------------------------------------------------------------------------
_fsim_jsbsim_read(models/propulsion/FGRotor.h _text)
