]=])
set(_new [=[  ct_t1 = (1.0/4.0*B[4] + 1.0/4.0 * B[2]*mu2) * BladeTwist;
  if (ClassicalModel) ct_t1 += 0.25*mu*p_w/Omega; // flightsim patch: roll rate's thrust, TM-73254 eq. 1
]=])
_fsim_jsbsim_edit(_text _old _new FGRotor.cpp "thrust")
set(_old [=[  nu  = flow_scale * ((nu - c0) * exp(-dt/InflowLag) + c0);
]=])
set(_new [=[  if (ClassicalModel) // flightsim patch: the ground effect scales the steady state
    nu = (nu - flow_scale*c0) * exp(-dt/InflowLag) + flow_scale*c0;
  else
    nu  = flow_scale * ((nu - c0) * exp(-dt/InflowLag) + c0);
]=])
_fsim_jsbsim_edit(_text _old _new FGRotor.cpp "ground effect")
set(_old [=[  J_side = BladeNum * BladeChord * Radius * rho * sqr(Omega*Radius) * cy_over_sigma;
]=])
set(_new [=[  J_side = BladeNum * BladeChord * Radius * rho * sqr(Omega*Radius) * cy_over_sigma;

  // flightsim patch: the classical H and Y forces in the control axes,
  // TM-73254 eq. 2 and 3 (its untwisted blade pitch is the 3/4-radius pitch)
  if (ClassicalModel) {
    const double r1 = BladeNum*BladeChord*Radius*rho*sqr(Omega*Radius) * LiftCurveSlope/2.0;
    const double mu2 = sqr(mu), pw = p_w/Omega, qw = q_w/Omega;
    const double delta = 0.009 + 0.3*sqr(6.0*C_T/(LiftCurveSlope*Solidity));
    H_drag = r1 * ( delta*mu/(2.0*LiftCurveSlope)
                    + a_1*(t075/3.0 + 0.75*lambda*(1.0 - 0.375*mu2) + 0.25*mu*a_1)
                    - 0.5*mu*lambda*t075*(1.0 - 2.0*mu/(3.0*M_PI)) - 0.25*sqr(lambda)*mu
                    - 0.375*lambda*mu2*(1.0 + 3.33*mu) - a0*(b_1/6.0 - 0.25*a0*mu)
                    - qw*(a0/6.0 + mu*b_1/16.0) - pw*(t075/6.0 + 0.5*lambda + mu*a_1/16.0) );
    J_side = r1 * ( a0*(a_1*(1.0/6.0 - mu2) - 1.5*mu*(lambda + 0.5*t075))
                    + b_1*(t075/3.0*(1.0 + 1.5*mu2) + 0.75*lambda + 0.25*mu*a_1)
                    + qw*(t075/6.0 + 0.5*lambda + 7.0/16.0*mu*a_1) - pw*(a0/6.0 - 5.0/16.0*mu*b_1) );
  }
]=])
