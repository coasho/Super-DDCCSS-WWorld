      bool pulseHold = false;
      bool pulseInputsValid = true;
      double pulseFuelLbs = 0.0;
      if (commandedPulse) {
        auto pm = FDMExec->GetPropertyManager();
        const auto value = [&](const char* leaf) {
          auto node = pm->GetNode(string("fsim/motor-pulse/") + leaf, false);
