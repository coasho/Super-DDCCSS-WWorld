# Validate the frozen compatibility inputs before staging any native fixture.
cmake_minimum_required(VERSION 3.25)
if(NOT DEFINED SOURCE_ROOT)
    message(FATAL_ERROR "An explicit source root is required")
endif()
set(_fixture_dir "${SOURCE_ROOT}/tests/simulation/fixtures/weapon-v2")
file(READ "${_fixture_dir}/manifest.json" _manifest)
string(JSON _schema GET "${_manifest}" schema)
if(NOT _schema STREQUAL "fsim.weapon-v2-native-fixture-source.v1")
    message(FATAL_ERROR "Unexpected V2 fixture provenance schema")
endif()
string(JSON _generator GET "${_manifest}" generator)
if(NOT _generator STREQUAL "tests/simulation/fixtures/weapon_v2_assets.py")
    message(FATAL_ERROR "Unexpected V2 fixture generator")
endif()
file(SHA256 "${SOURCE_ROOT}/${_generator}" _actual)
string(JSON _expected GET "${_manifest}" generator_sha256)
if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "V2 fixture generator changed; regenerate the explicit compatibility fixtures")
endif()
foreach(_dependency IN ITEMS catalogue normalizer)
    string(JSON _path GET "${_manifest}" dependencies ${_dependency} path)
    string(JSON _expected GET "${_manifest}" dependencies ${_dependency} sha256)
    file(SHA256 "${SOURCE_ROOT}/${_path}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "V2 fixture normalization dependency changed; regenerate the explicit compatibility fixtures")
    endif()
endforeach()
string(JSON _count LENGTH "${_manifest}" files)
if(NOT _count EQUAL 4)
    message(FATAL_ERROR "Exactly four frozen compatibility profiles are required")
endif()
set(_remaining aim-9m aim-9x aim-7m aim-120c)
foreach(_index RANGE 0 3)
    string(JSON _input GET "${_manifest}" files ${_index} input)
    get_filename_component(_name "${_input}" NAME_WE)
    if(NOT _name IN_LIST _remaining OR NOT _input STREQUAL "assets/stores/${_name}.json")
        message(FATAL_ERROR "Unexpected or duplicate V2 fixture input")
    endif()
    list(REMOVE_ITEM _remaining "${_name}")
    string(JSON _fixture GET "${_manifest}" files ${_index} fixture)
    if(NOT _fixture STREQUAL "tests/simulation/fixtures/weapon-v2/${_name}.json")
        message(FATAL_ERROR "Unexpected V2 fixture output")
    endif()
    foreach(_kind input fixture)
        string(JSON _path GET "${_manifest}" files ${_index} ${_kind})
        string(JSON _expected GET "${_manifest}" files ${_index} ${_kind}_sha256)
        file(SHA256 "${SOURCE_ROOT}/${_path}" _actual)
        if(NOT _actual STREQUAL _expected)
            message(FATAL_ERROR "V2 ${_kind} hash changed: ${_name}; regenerate the explicit compatibility fixtures")
        endif()
    endforeach()
    file(READ "${SOURCE_ROOT}/${_fixture}" _card)
    string(JSON _selected GET "${_manifest}" files ${_index} selected_seeker)
    string(JSON _actual GET "${_card}" component_models components seeker implementation_id)
    if(NOT _actual STREQUAL _selected OR NOT _selected MATCHES "[.]v2$")
        message(FATAL_ERROR "V2 compatibility fixture selected another detector")
    endif()
endforeach()
message(STATUS "Four V2 compatibility input/output/generator hashes verified")
