    {"from": "world", "to": "sim", "rule": "domain", "until": "ARCH-06", "reason": "Scene construction reads simulation state types; ARCH-06 makes it consume read-only frames and contracts"},
    {"from": "ui", "to": "sim", "rule": "domain", "until": "ARCH-06", "reason": "Viewer widgets read simulation state types; ARCH-06 makes them consume read-only frames and contracts"}
